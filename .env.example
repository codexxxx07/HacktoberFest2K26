# Clerk authentication (copy this file to .env.local and fill in your own keys)
# Get your keys from https://dashboard.clerk.com
# The publishable key is public and safe to expose to the browser.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: backend secret, only used server-side. Never put this in frontend-only VITE_* vars.
# CLERK_SECRET_KEY=

# OpenAI API for Clara AI Assistant
# Get your API key from https://platform.openai.com/api-keys
#
# SECURITY WARNING: This is a FRONTEND-ONLY implementation.
# VITE_ prefixed variables are exposed to the browser and are NOT secret.
# If deployed publicly, the API key can be extracted by users.
# This approach is suitable for local development and personal use only.
# For production, use a backend proxy to protect the API key.
#
# NEVER:
# - Hardcode a real API key in source code
# - Commit a real API key to Git
# - Print the API key in console logs
# - Include the API key in error messages
#
# Optional: Specify a custom OpenAI model (defaults to gpt-4o-mini)
# VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_API_KEY=